{
  "name": "dsh-thinking-guard",
  "version": "0.1.16",
  "description": "DSH 能力目录与按需调用策略、Agent/Turn 执行计数及精确重复调用提醒；不执行预算硬停止或循环阻止。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YAN3RA/dsh-thinking-guard.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "bundle": "tsdown",
    "bridge": "node scripts/bridge-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/search.js"
    },
    "./invoke": {
      "types": "./lib/types/invoke.d.ts",
      "default": "./lib/invoke.js"
    },
    "./policy": {
      "types": "./lib/types/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.2.0 || ^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "js-yaml": "^4.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "clsx": "^2.1.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
